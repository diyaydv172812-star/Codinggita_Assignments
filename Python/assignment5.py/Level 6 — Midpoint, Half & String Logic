#47
s = input()
first = ""
second = ""
middle = ""
mid = len(s) // 2
for i in range(len(s)):
    if i < mid:
        first += s[i]
    elif len(s) % 2 == 1 and i == mid:
        middle = s[i]
    else:
        second += s[i]
print("First Half:", first)
if middle:
    print("Middle:", middle)
print("Second Half:", second)

#48
s = input()
mid = len(s) // 2
same = True
for i in range(mid):
    if s[i] != s[i + mid]:
        same = False
if same:
    print("Equal Halves")
else:
    print("Different Halves")

#49
s = input()
symmetric = True
for i in range(len(s) // 2):
    if s[i] != s[len(s) - 1 - i]:
        symmetric = False
if symmetric:
    print("Symmetric")
else:
    print("Not Symmetric")

