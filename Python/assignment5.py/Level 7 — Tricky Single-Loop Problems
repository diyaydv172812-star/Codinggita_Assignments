#57
n = int(input())
even = 0
odd = 0
for i in range(len(str(n))):
    if (n % 10) % 2 == 0:
        even += 1
    else:
        odd += 1
    n //= 10
if even > odd:
    print("More Even Digits")
elif odd > even:
    print("More Odd Digits")
else:
    print("Equal")

