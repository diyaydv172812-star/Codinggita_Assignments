#53
n = int(input())
largest = -1
second = -1
for i in range(len(str(n))):
    digit = n % 10
    if digit > largest:
        second = largest
        largest = digit
    elif digit != largest and digit > second:
        second = digit
    n //= 10
print(second)

#54
s = input()
current = 0
best = 0
previous = ""
for ch in s:
    if ch == previous:
        current += 1
    else:
        current = 1
    if current > best:
        best = current
    previous = ch
print(best)

#55
s, target = input().split()
count = 0
for ch in s:
    if ch == target:
        count += 1
print("Count =", count, "Frequency =", round(count / len(s) * 100, 2), "%")

